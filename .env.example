# Local or AWS runtime configuration. Keep real secret values out of
# this example; copy the local template or inject secrets from a vault.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PAYLOAD_SECRET=replace-with-a-long-random-secret
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# PAYLOAD_STORAGE=local
#
# For AWS S3 media storage:
# PAYLOAD_STORAGE=s3
# AWS_REGION=us-east-1
# S3_BUCKET=your-media-bucket
# S3_PREFIX=media
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# ASSET_CDN_URL=https://your-cloudfront-domain.example
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# On AWS, prefer a task role instead of static AWS access keys. A secrets
# manager or Vault should inject secrets as environment variables at runtime.
# ASSET_CDN_URL is a public CloudFront origin used for website media delivery.
